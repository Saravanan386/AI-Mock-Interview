# Fast local mode (no Docker required).
DATABASE_URL=sqlite:///./velai.db
# To use Docker PostgreSQL instead:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/velai
JWT_SECRET_KEY=change-me-in-development
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local LiteLLM/OpenAI-compatible endpoint.
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=local-dev-key
LLM_MODEL=llama3.1
LLM_ENABLED=false
LLM_TIMEOUT_SECONDS=5

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=recruitment_jobs
VECTOR_SIZE=128

# Optional live search grounding for interview questions.
LIVE_SEARCH_ENABLED=false
LIVE_SEARCH_TIMEOUT_SECONDS=6
STRICT_AI_MODE=false
